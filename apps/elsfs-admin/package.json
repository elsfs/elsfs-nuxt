{
  "name": "elsfs-admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "pnpm lint:eslint && pnpm lint:oxlint && pnpm lint:style && pnpm lint:spell",
    "lint:eslint": "eslint .",
    "lint:oxlint": "oxlint",
    "lint:style": "stylelint \"**/*.{css,vue}\"",
    "lint:spell": "cspell lint \"**/*.{ts,vue,js,mjs,cjs,json,jsonc,md,mdx,css,yaml,yml}\"",
    "fmt": "oxfmt -c ../../packages/code-quality/oxfmt.json",
    "fmt:check": "oxfmt --check -c ../../packages/code-quality/oxfmt.json",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/mdi": "^1.2.0",
    "@nuxtjs/i18n": "catalog:",
    "@nuxtjs/tailwindcss": "catalog:",
    "@pinia/nuxt": "catalog:",
    "nuxt-request": "workspace:*",
    "tailwind-config": "workspace:*",
    "tailwindcss": "^4.3.3",
    "vee-validate": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@element-plus/nuxt": "1.1.5",
    "element-plus": "^2.14.5",
    "@nuxt/devtools": "^3.4.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/eslint-config": "catalog:",
    "@nuxtjs/color-mode": "4.0.1",
    "@types/node": "latest",
    "code-quality": "workspace:*",
    "cspell": "catalog:",
    "eslint": "^10.8.1",
    "nuxt": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "postcss-html": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard": "catalog:",
    "typescript": "catalog:",
    "vite-plugin-eslint2": "^5.3.0",
    "vue-tsc": "^3.3.9"
  }
}
